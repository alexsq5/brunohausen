{
  "redirects": [
    { "source": "/ils/:path*", "has": [{ "type": "host", "value": "brunohausen.de" }], "destination": "https://inletztersekunde.de/:path*", "permanent": false },
    { "source": "/ils/:path*", "has": [{ "type": "host", "value": "www.brunohausen.de" }], "destination": "https://inletztersekunde.de/:path*", "permanent": false }
  ],
  "rewrites": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "inletztersekunde.de" }], "destination": "/ils/:path*" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.inletztersekunde.de" }], "destination": "/ils/:path*" }
  ]
}
